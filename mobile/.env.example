EXPO_PUBLIC_APP_URL=https://www.iratepilot.com
# Safe public client credentials only. Never use the service-role key in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Publishable key only (pk_test_ or pk_live_). It must match the web API payment mode.
# Never put STRIPE_SECRET_KEY or a webhook secret in the mobile app.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
