{
  "name": "@iratepilot/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "security:assets": "node scripts/check-asset-formats.mjs",
    "security:dependencies": "node scripts/check-dependency-security.mjs",
    "security:runtime": "node scripts/check-dependency-runtime.mjs",
    "security:check": "npm run security:dependencies && npm run security:assets",
    "typecheck": "tsc --noEmit",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@stripe/stripe-react-native": "0.64.0",
    "@supabase/supabase-js": "^2.111.0",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
