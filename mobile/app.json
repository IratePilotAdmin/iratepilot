{
  "expo": {
    "name": "iRatePilot",
    "slug": "iratepilot",
    "owner": "ceoiratepilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "iratepilot",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iratepilot.app",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "iRatePilot uses the camera only when you choose to scan payment card details during secure checkout."
      }
    },
    "android": {
      "package": "com.iratepilot.app",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#020b36"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      ["@stripe/stripe-react-native", { "enableGooglePay": false }],
      ["expo-notifications", { "defaultChannel": "bookings" }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "052043d3-9483-4a86-a01f-b9d63cf8df2e"
      }
    }
  }
}
