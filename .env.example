NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Preferred for new Supabase projects:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use this instead:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe recurring prices must use yearly billing: Basic $70/year and Business $120/year.
STRIPE_BASIC_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_PARTNER_STARTER_PRICE_ID=
STRIPE_PARTNER_PROFESSIONAL_PRICE_ID=
STRIPE_PARTNER_PREMIUM_PRICE_ID=
OPENAI_API_KEY=
RESEND_API_KEY=
# Used by Vercel Cron as an Authorization bearer token.
CRON_SECRET=
RESEND_FROM_EMAIL=iRatePilot <team@mail.iratepilot.com>
EMAIL_REPLY_TO=
NEXT_PUBLIC_PUBLIC_BOOKING=false
NEXT_PUBLIC_ENABLE_TEST_CHECKOUT=false
ENABLE_TEST_CHECKOUT=false
PILOT_MODE=true
