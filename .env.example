NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Preferred for new Supabase projects:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use this instead:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only 32-byte base64 key for AES-256-GCM PMS credential encryption.
PMS_CREDENTIAL_ENCRYPTION_KEY=
# Oracle OPERA Cloud Distribution Shop/Book credentials. These are separate
# from OHIP Property API credentials and are issued during channel onboarding.
PMS_ORACLE_OPERA_DISTRIBUTION_BASE_URL=
PMS_ORACLE_OPERA_DISTRIBUTION_TOKEN_URL=
PMS_ORACLE_OPERA_DISTRIBUTION_USERNAME=
PMS_ORACLE_OPERA_DISTRIBUTION_PASSWORD=
PMS_ORACLE_OPERA_DISTRIBUTION_APP_KEY=
PMS_ORACLE_OPERA_DISTRIBUTION_CHANNEL_CODE=
PMS_ORACLE_OPERA_DISTRIBUTION_ORIGIN=iRatePilot
PMS_ORACLE_OPERA_DISTRIBUTION_TIMEOUT_MS=15000
# Bearer credential agreed with Oracle for outbound ARI/notification delivery.
PMS_ORACLE_OPERA_WEBHOOK_SECRET=
# OHIP Property API credentials and approved hotel scope.
PMS_ORACLE_OPERA_BASE_URL=
PMS_ORACLE_OPERA_TOKEN_URL=
PMS_ORACLE_OPERA_CLIENT_ID=
PMS_ORACLE_OPERA_CLIENT_SECRET=
PMS_ORACLE_OPERA_APP_KEY=
PMS_ORACLE_OPERA_HOTEL_ID=
PMS_ORACLE_OPERA_TIMEOUT_MS=15000
# Brand/vendor-issued booking endpoints. Never infer or guess these paths.
PMS_HILTON_PEP_BASE_URL=
PMS_HILTON_PEP_API_CREDENTIAL=
PMS_HILTON_PEP_AVAILABILITY_PATH=
PMS_HILTON_PEP_CREATE_PATH=
PMS_HILTON_PEP_GET_PATH=
PMS_HILTON_PEP_MODIFY_PATH=
PMS_HILTON_PEP_CANCEL_PATH=
PMS_HILTON_PEP_VALIDATION_PATH=
PMS_HILTON_PEP_WEBHOOK_SECRET=
PMS_HILTON_ONQ_BASE_URL=
PMS_HILTON_ONQ_API_CREDENTIAL=
PMS_HILTON_ONQ_AVAILABILITY_PATH=
PMS_HILTON_ONQ_CREATE_PATH=
PMS_HILTON_ONQ_GET_PATH=
PMS_HILTON_ONQ_MODIFY_PATH=
PMS_HILTON_ONQ_CANCEL_PATH=
PMS_HILTON_ONQ_VALIDATION_PATH=
PMS_HILTON_ONQ_WEBHOOK_SECRET=
PMS_MARRIOTT_FOSSE_BASE_URL=
PMS_MARRIOTT_FOSSE_API_CREDENTIAL=
PMS_MARRIOTT_FOSSE_AVAILABILITY_PATH=
PMS_MARRIOTT_FOSSE_CREATE_PATH=
PMS_MARRIOTT_FOSSE_GET_PATH=
PMS_MARRIOTT_FOSSE_MODIFY_PATH=
PMS_MARRIOTT_FOSSE_CANCEL_PATH=
PMS_MARRIOTT_FOSSE_VALIDATION_PATH=
PMS_MARRIOTT_FOSSE_WEBHOOK_SECRET=
PMS_MARRIOTT_FS_PMS_BASE_URL=
PMS_MARRIOTT_FS_PMS_API_CREDENTIAL=
PMS_MARRIOTT_FS_PMS_AVAILABILITY_PATH=
PMS_MARRIOTT_FS_PMS_CREATE_PATH=
PMS_MARRIOTT_FS_PMS_GET_PATH=
PMS_MARRIOTT_FS_PMS_MODIFY_PATH=
PMS_MARRIOTT_FS_PMS_CANCEL_PATH=
PMS_MARRIOTT_FS_PMS_VALIDATION_PATH=
PMS_MARRIOTT_FS_PMS_WEBHOOK_SECRET=
PMS_HOTELKEY_BASE_URL=
PMS_HOTELKEY_API_CREDENTIAL=
PMS_HOTELKEY_AVAILABILITY_PATH=
PMS_HOTELKEY_CREATE_PATH=
PMS_HOTELKEY_GET_PATH=
PMS_HOTELKEY_MODIFY_PATH=
PMS_HOTELKEY_CANCEL_PATH=
PMS_HOTELKEY_VALIDATION_PATH=
PMS_HOTELKEY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe recurring prices must use yearly billing: Basic $70/year and Business $120/year.
STRIPE_BASIC_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_PARTNER_STARTER_PRICE_ID=
STRIPE_PARTNER_PROFESSIONAL_PRICE_ID=
STRIPE_PARTNER_PREMIUM_PRICE_ID=
OPENAI_API_KEY=
RESEND_API_KEY=
# Verified sender used for transactional booking and partner messages.
RESEND_FROM_EMAIL=
# Optional address for customer and partner replies.
EMAIL_REPLY_TO=
# Required by Vercel Cron and any manual email worker invocation.
CRON_SECRET=
NEXT_PUBLIC_PUBLIC_BOOKING=false
NEXT_PUBLIC_ENABLE_TEST_CHECKOUT=false
ENABLE_TEST_CHECKOUT=false
# Commercial launch only: requires sk_live_/pk_live_ keys, public booking=true,
# PILOT_MODE=false, and a separately enabled live webhook endpoint.
ENABLE_LIVE_BOOKING_PAYMENTS=false
# Live Stripe Connect onboarding and guarded partner transfers (requires verified production migration 029 before activation).
ENABLE_LIVE_PARTNER_PAYOUTS=false
ENABLE_LIVE_STRIPE_WEBHOOKS=false
PILOT_MODE=true
# Mobile push delivery remains off until migration 030, EAS credentials, and physical-device QA are complete.
ENABLE_MOBILE_PUSH_NOTIFICATIONS=false
# Optional server-only Expo access token when enhanced push security is enabled in EAS.
EXPO_ACCESS_TOKEN=
